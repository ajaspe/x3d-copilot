    <ROUTE fromNode="MercuryClock" fromField="fraction_changed" toNode="MercurySpin" toField="set_fraction"/>
    <ROUTE fromNode="MercurySpin" fromField="value_changed" toNode="MercuryOrbit" toField="set_rotation"/>
    <!-- Venus: orbit radius 4.3, period 10s -->
    <Transform DEF="VenusOrbit">
      <Transform translation="4.3 0 0">
        <Shape>
          <Appearance><Material diffuseColor="0.9 0.75 0.45"/></Appearance>
          <Sphere radius="0.3"/>
        </Shape>
