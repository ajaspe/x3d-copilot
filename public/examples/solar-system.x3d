        </Transform>
        <Transform rotation="1 0 0 1.5708">
          <Shape>
            <Appearance><Material emissiveColor="0.3 0.3 0.4"/></Appearance>
            <Circle2D radius="1.45"/>
          </Shape>
        </Transform>
      </Transform>
    </Transform>
    <TimeSensor DEF="SaturnClock" cycleInterval="75" loop="true"/>
    <OrientationInterpolator DEF="SaturnSpin" key="0 0.5 1" keyValue="0 1 0 0  0 1 0 3.14159  0 1 0 6.28318"/>
    <ROUTE fromNode="SaturnClock" fromField="fraction_changed" toNode="SaturnSpin" toField="set_fraction"/>
    <ROUTE fromNode="SaturnSpin" fromField="value_changed" toNode="SaturnOrbit" toField="set_rotation"/>
    <!-- Orbit guide rings -->
    <Transform rotation="1 0 0 1.5708">
      <Shape>
        <Appearance><Material emissiveColor="0.2 0.2 0.3"/></Appearance>
        <Circle2D radius="6"/>
      </Shape>
      <Shape>
        <Appearance><Material emissiveColor="0.15 0.15 0.22"/></Appearance>
        <Circle2D radius="11.5"/>
      </Shape>
      <Shape>
        <Appearance><Material emissiveColor="0.15 0.15 0.22"/></Appearance>
        <Circle2D radius="15"/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
