    <TimeSensor DEF="WaveClock" cycleInterval="2" loop="true"/>
    <OrientationInterpolator DEF="ShoulderWave" key="0 0.5 1" keyValue="0 0 1 -2.6  0 0 1 -2.2  0 0 1 -2.6"/>
