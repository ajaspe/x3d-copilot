    <HAnimHumanoid DEF="Robby" name="Robby" version="2.0" skeletalConfiguration="BASIC" loa="1">
      <HAnimJoint DEF="Robby_humanoid_root" name="humanoid_root" center="0 0.82 0" containerField="skeleton">
