            </HAnimJoint>
          </HAnimJoint>

          <HAnimJoint DEF="Robby_l_shoulder" name="l_shoulder" center="0.32 1.35 0">
            <HAnimSegment DEF="Robby_l_upperarm" name="l_upperarm">
              <Transform translation="0.32 1.15 0">
                <Shape>
