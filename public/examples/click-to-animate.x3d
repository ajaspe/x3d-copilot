<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <meta name="title" content="click-to-animate.x3d"/>
    <meta name="description" content="Click the cone: TouchSensor.touchTime starts a one-shot TimeSensor that drives a PositionInterpolator (bounce) and a ColorInterpolator."/>
    <meta name="generator" content="X3D Copilot"/>
  </head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    <Background skyColor="0.55 0.75 0.95 0.85 0.9 1" skyAngle="1.4" groundColor="0.3 0.35 0.3"/>
    <Viewpoint description="Front" position="0 1.5 7" orientation="1 0 0 -0.15"/>

    <Transform DEF="Bouncer">
      <Shape>
        <Appearance>
          <Material DEF="ConeMat" diffuseColor="0.2 0.7 0.3"/>
        </Appearance>
        <Cone bottomRadius="0.8" height="1.6"/>
      </Shape>
      <TouchSensor DEF="Touch" description="Click me"/>
    </Transform>

    <Transform translation="0 -0.85 0">
      <Shape>
        <Appearance><Material diffuseColor="0.6 0.55 0.5"/></Appearance>
        <Box size="6 0.1 6"/>
      </Shape>
    </Transform>

    <Billboard axisOfRotation="0 0 0">
      <Transform translation="0 2.2 0">
        <Shape>
          <Appearance><Material diffuseColor="0.1 0.1 0.2" emissiveColor="0.1 0.1 0.2"/></Appearance>
          <Text string='"Click the cone"'>
            <FontStyle family='"SANS"' style="BOLD" justify='"MIDDLE" "MIDDLE"' size="0.5"/>
          </Text>
        </Shape>
      </Transform>
    </Billboard>

    <TimeSensor DEF="Bounce" cycleInterval="1.2" loop="false"/>
    <PositionInterpolator DEF="Jump" key="0 0.5 1" keyValue="0 0 0  0 1.8 0  0 0 0"/>
    <ColorInterpolator DEF="Flash" key="0 0.5 1" keyValue="0.2 0.7 0.3  1 0.9 0.1  0.2 0.7 0.3"/>

    <ROUTE fromNode="Touch" fromField="touchTime" toNode="Bounce" toField="set_startTime"/>
    <ROUTE fromNode="Bounce" fromField="fraction_changed" toNode="Jump" toField="set_fraction"/>
    <ROUTE fromNode="Jump" fromField="value_changed" toNode="Bouncer" toField="set_translation"/>
    <ROUTE fromNode="Bounce" fromField="fraction_changed" toNode="Flash" toField="set_fraction"/>
    <ROUTE fromNode="Flash" fromField="value_changed" toNode="ConeMat" toField="set_diffuseColor"/>
  </Scene>
</X3D>
