{
    "name":  "x3d-copilot",
    "private":  true,
    "version":  "0.1.0",
    "description":  "X3D Copilot - a browser-based X3D 4.0 editor with a spec-grounded AI co-author, live X_ITE rendering, schema + semantic validation, and multi-format import/export.",
    "type":  "module",
    "license":  "MIT",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "typecheck":  "tsc --noEmit",
                    "postinstall":  "node scripts/vendor-x_ite.mjs",
                    "build:uom":  "node scripts/build-uom.mjs"
                },
    "dependencies":  {
                         "@anthropic-ai/sdk":  "^0.126.0",
                         "@codemirror/autocomplete":  "^6.20.3",
                         "@codemirror/commands":  "^6.11.1",
                         "@codemirror/lang-xml":  "^6.1.0",
                         "@codemirror/language":  "^6.12.4",
                         "@codemirror/lint":  "^6.9.7",
                         "@codemirror/search":  "^6.7.2",
                         "@codemirror/state":  "^6.7.5",
                         "@codemirror/theme-one-dark":  "^6.1.3",
                         "@codemirror/view":  "^6.43.12",
                         "codemirror":  "^6.0.2",
                         "libxml2-wasm":  "^0.7.2",
                         "x_ite":  "^16.3.1"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.20.3",
                            "typescript":  "^7.0.2",
                            "vite":  "^8.3.0",
                            "vitest":  "^5.0.1"
                        }
}